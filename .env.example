# docker compose が同じディレクトリの .env を自動で読み込む。
# 使うときは cp .env.example .env して値を埋める（.env はコミットしない）。
#
# ローカル開発では .env を置かなくてよい。その場合 docker-compose.yml の
# 既定値（postgres / postgres）で起動する。

POSTGRES_DB=escape_the_office
POSTGRES_USER=postgres
# 本番では推測できない値に変える。パスワードの変更が効くのは
# ボリュームが空の初回起動時のみ（既存データがある場合は作り直しが必要）
POSTGRES_PASSWORD=change-me
